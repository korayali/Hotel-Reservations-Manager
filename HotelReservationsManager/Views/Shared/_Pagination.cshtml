@using HotelReservationsManager.Models.ViewModels.Shared
@model PagingViewModel
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var routeValues = ViewContext.HttpContext.Request.Query
        .Where(q => q.Key != "page")
        .ToDictionary(q => q.Key, q => q.Value.ToString());
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <small class="text-muted">
        Showing @Model.StartItem–@Model.EndItem of @Model.TotalItems
    </small>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination mb-0">
                @* First *@
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    @{
                        routeValues["page"] = "1";
                    }
                    <a class="page-link" asp-action="@action" asp-all-route-data="routeValues">«</a>
                </li>

                @* Previous *@
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    @{
                        routeValues["page"] = (Model.CurrentPage - 1).ToString();
                    }
                    <a class="page-link" asp-action="@action" asp-all-route-data="routeValues">‹</a>
                </li>

                @* Page range *@
                @foreach (var p in Model.GetPageRange())
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        @{
                            routeValues["page"] = p.ToString();
                        }
                        <a class="page-link" asp-action="@action" asp-all-route-data="routeValues">@p</a>
                    </li>
                }

                @* Next *@
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    @{
                        routeValues["page"] = (Model.CurrentPage + 1).ToString();
                    }
                    <a class="page-link" asp-action="@action" asp-all-route-data="routeValues">›</a>
                </li>

                @* Last *@
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    @{
                        routeValues["page"] = Model.TotalPages.ToString();
                    }
                    <a class="page-link" asp-action="@action" asp-all-route-data="routeValues">»</a>
                </li>
            </ul>
        </nav>
    }
</div>