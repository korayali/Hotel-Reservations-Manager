@using HotelReservationsManager.Models.ViewModels.Shared
@model PagingViewModel
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var baseRouteValues = ViewContext.HttpContext.Request.Query
        .Where(q => q.Key != "page" && q.Key != "pageSize")
        .ToDictionary(q => q.Key, q => q.Value.ToString());

    Dictionary<string, string> GetRoute(int page, int? pageSize = null)
    {
        var dict = new Dictionary<string, string>(baseRouteValues);
        dict["page"] = page.ToString();
        dict["pageSize"] = (pageSize ?? Model.PageSize).ToString();
        return dict;
    }
}

<div class="d-flex align-items-center justify-content-between mt-4 flex-nowrap">
    <div class="d-flex align-items-center">
        <form method="get" asp-action="@action" class="d-flex align-items-center me-3">
            @foreach (var val in baseRouteValues)
            {
                <input type="hidden" name="@val.Key" value="@val.Value" />
            }
            <label class="me-2 mb-0 small text-muted text-nowrap">Show:</label>
            <select name="pageSize"
                    class="form-select form-select-sm w-auto shadow-none"
                    style="padding-right: 1.5rem; min-width: 65px;"
                    onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </form>

        <small class="text-muted text-nowrap d-none d-sm-block">
            Showing @Model.StartItem–@Model.EndItem of @Model.TotalItems
        </small>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0 flex-nowrap">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="@action" asp-all-route-data="GetRoute(1)">«</a>
                </li>
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="@action" asp-all-route-data="GetRoute(Model.CurrentPage - 1)">‹</a>
                </li>

                @foreach (var p in Model.GetPageRange())
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="@action" asp-all-route-data="GetRoute(p)">@p</a>
                    </li>
                }

                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="@action" asp-all-route-data="GetRoute(Model.CurrentPage + 1)">›</a>
                </li>
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="@action" asp-all-route-data="GetRoute(Model.TotalPages)">»</a>
                </li>
            </ul>
        </nav>
    }
</div>