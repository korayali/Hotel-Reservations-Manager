@model HotelReservationsManager.Models.ViewModels.Reservation.EditReservationViewModel

@{
    ViewData["Title"] = $"Edit Reservation #{Model.Id}";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="h3 mb-0">Edit Reservation #@Model.Id</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Details
    </a>
</div>

<div class="row g-4">
    <!-- FORM -->
    <div class="col-lg-8">
        <div class="card card-gold h-100">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input asp-for="Id" type="hidden" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CheckInDate" class="form-label"></label>
                            <input asp-for="CheckInDate" id="CheckInDate" class="form-control" type="date" min="@today" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CheckOutDate" class="form-label"></label>
                            <input asp-for="CheckOutDate" id="CheckOutDate" class="form-control" type="date" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label"></label>
                            <select asp-for="RoomId" id="RoomId" class="form-select"></select>
                        </div>

                        <div class="col-12">
                            <label asp-for="GuestIds" class="form-label"></label>
                            <select asp-for="GuestIds" id="GuestIds" class="form-select" multiple></select>
                            <div class="form-text">Select multiple guests (Ctrl / Cmd)</div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="HasBreakfast" id="HasBreakfast" class="form-check-input" />
                                <label asp-for="HasBreakfast" class="form-check-label">Breakfast included</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsAllInclusive" id="IsAllInclusive" class="form-check-input" />
                                <label asp-for="IsAllInclusive" class="form-check-label">All Inclusive</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">Reservation Summary</div>
            <div class="card-body">
                <div id="capacityWarning" class="alert alert-warning d-none">
                    <span id="capacityWarningText"></span>
                </div>

                <p><strong>Nights:</strong> <span id="nightsCount">0</span></p>
                <p><strong>Room capacity:</strong> <span id="roomCapacity">—</span></p>
                <p><strong>Guests:</strong> <span id="guestCount">0</span></p>
                <p><strong>Breakfast:</strong> <span id="breakfastStatus">No</span></p>
                <p><strong>All Inclusive:</strong> <span id="allInclusiveStatus">No</span></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Persisted across AJAX reloads so validation-failure round-trips restore selections
        var previousRoomId = "@Model.RoomId";
        var previousGuestIds = @Html.Raw(
                    Model.GuestIds != null && Model.GuestIds.Any()
                        ? "[" + string.Join(",", Model.GuestIds) + "]"
                        : "[]");

        // Capacity of the currently selected room (set when room AJAX data loads)
        var currentRoomCapacity = null;

        function loadAvailableData() {
        const checkIn = $("#CheckInDate").val();
        const checkOut = $("#CheckOutDate").val();
        if (!checkIn || !checkOut || checkOut <= checkIn) return;

        $("#noDateHint").hide();

        // Rooms — response now includes { id, text, capacity }
        $.get('/Reservations/GetAvailableRooms', { checkIn, checkOut }, function (data) {
        const roomSelect = $("#RoomId");
        roomSelect.empty();

        // Store capacity per room id so we can look it up on selection change
        roomSelect.data('capacityMap', {});
        const capacityMap = {};

        data.forEach(r => {
        capacityMap[r.id] = r.capacity;
        const option = new Option(r.text, r.id, false, String(r.id) === String(previousRoomId));
        roomSelect.append(option);
        });

        roomSelect.data('capacityMap', capacityMap);
        roomSelect.trigger('change'); // triggers updateSummary via event binding
        }).fail(function () {
        console.warn("Failed to load available rooms.");
        });

        // Guests
        $.get('/Reservations/GetAvailableGuests', { checkIn, checkOut }, function (data) {
        const guestSelect = $("#GuestIds");
        guestSelect.empty();

        data.forEach(g => {
        const selected = previousGuestIds.includes(g.id);
        guestSelect.append(new Option(g.text, g.id, false, selected));
        });

        guestSelect.trigger('change');
        updateSummary();
        }).fail(function () {
        console.warn("Failed to load available guests.");
        });
        }

        function updateSummary() {
        // Nights
        const checkIn = new Date($("#CheckInDate").val());
        const checkOut = new Date($("#CheckOutDate").val());
        const nights = (!isNaN(checkIn) && !isNaN(checkOut))
        ? Math.max(0, (checkOut - checkIn) / (1000 * 60 * 60 * 24))
        : 0;
        $("#nightsCount").text(nights);

        // Room capacity — read from the capacity map stored on the select element
        const roomSelect = $("#RoomId");
        const selectedRoomId = roomSelect.val();
        const capacityMap = roomSelect.data('capacityMap') || {};
        currentRoomCapacity = selectedRoomId ? (capacityMap[selectedRoomId] ?? null) : null;
        $("#roomCapacity").text(currentRoomCapacity !== null ? currentRoomCapacity : "—");

        // Guest count
        const guestCount = $("#GuestIds").val()?.length || 0;
        $("#guestCount").text(guestCount);

        // Capacity warning
        if (currentRoomCapacity !== null && guestCount > currentRoomCapacity) {
        $("#capacityWarningText").text(
        `This room fits ${currentRoomCapacity} guest(s), but ${guestCount} are selected. ` +
        `You can still save, but please confirm this is intentional.`
        );
        $("#capacityWarning").removeClass("d-none");
        } else {
        $("#capacityWarning").addClass("d-none");
        }

        // Options
        $("#breakfastStatus").text($("#HasBreakfast").is(":checked") ? "Yes" : "No");
        $("#allInclusiveStatus").text($("#IsAllInclusive").is(":checked") ? "Yes" : "No");
        }

        $(document).ready(function () {
        $("#RoomId").select2({ placeholder: "Select check-in/out dates first" });
        $("#GuestIds").select2({ placeholder: "Select check-in/out dates first" });

        const checkIn = $("#CheckInDate").val();
        const checkOut = $("#CheckOutDate").val();

        if (checkIn && checkOut && checkOut > checkIn) {
        loadAvailableData();
        } else {
        $("#noDateHint").show();
        }

        updateSummary();

        $("#CheckInDate, #CheckOutDate").on("change", function () {
        const ci = $("#CheckInDate").val();
        const co = $("#CheckOutDate").val();

        if (ci && co && co <= ci) {
        const next = new Date(new Date(ci).getTime() + 24 * 60 * 60 * 1000);
        $("#CheckOutDate").val(next.toISOString().slice(0, 10));
        }

        // Clear stale selections when dates change
        previousRoomId = "";
        previousGuestIds = [];

        if ($("#CheckInDate").val() && $("#CheckOutDate").val()) {
        loadAvailableData();
        }

        updateSummary();
        });

        $("#GuestIds, #HasBreakfast, #IsAllInclusive, #RoomId").on("change", updateSummary);
        });
    </script>
}