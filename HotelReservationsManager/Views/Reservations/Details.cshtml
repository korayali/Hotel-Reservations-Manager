@model HotelReservationsManager.Models.ViewModels.Reservation.DetailsReservationViewModel

@{
    ViewData["Title"] = $"Reservation #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="h3 mb-0">Reservation <span class="text-muted fw-normal">#@Model.Id</span></h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-4">
    @* Left — reservation info *@
    <div class="col-md-5">
        <div class="card card-gold h-100">
            <div class="card-header">
                <i class="bi bi-calendar-check me-2"></i>Reservation Details
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.RoomNumber)</dt>
                    <dd class="col-sm-7">@Model.RoomNumber — @Model.RoomTypeDisplay</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.RoomCapacity)</dt>
                    <dd class="col-sm-7">@Model.RoomCapacity</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.BookedByUserName)</dt>
                    <dd class="col-sm-7">@Model.BookedByUserName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.CheckInDate)</dt>
                    <dd class="col-sm-7">@Model.CheckInDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.CheckOutDate)</dt>
                    <dd class="col-sm-7">@Model.CheckOutDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Nights)</dt>
                    <dd class="col-sm-7">@Model.Nights</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.HasBreakfast)</dt>
                    <dd class="col-sm-7">
                        @if (Model.HasBreakfast)
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle text-muted"></i>
                        }
                    </dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.IsAllInclusive)</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsAllInclusive)
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle text-muted"></i>
                        }
                    </dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.TotalPrice)</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.TotalPrice.ToString("C")</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Status)</dt>
                    <dd class="col-sm-7">
                        <span class="@Model.StatusBadgeClass">@Model.Status</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @* Right — guests *@
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-people me-2"></i>Guests (@Model.Guests.Count())
            </div>
            <div class="card-body p-0">
                @if (!Model.Guests.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-person-x fs-2"></i>
                        <p class="mt-2 mb-0">No guests on this reservation.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Type</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model.Guests)
                                {
                                    <tr>
                                        <td>@g.FullName</td>
                                        <td>@g.Email</td>
                                        <td>@g.PhoneNumber</td>
                                        <td>
                                            @if (g.IsAdult)
                                            {
                                                <span class="badge bg-primary">Adult</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Minor</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Guests" asp-action="Details"
                                               asp-route-id="@g.GuestId" class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
