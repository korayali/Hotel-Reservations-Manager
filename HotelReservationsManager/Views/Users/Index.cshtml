@using HotelReservationsManager.Models.ViewModels.User
@using HotelReservationsManager.Enums

@model UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">User Management</h2>
    <span class="text-muted">@Model.TotalItems user(s) found</span>
</div>

@* Filter Form *@
<form method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Filters.FirstName" class="form-label"></label>
                <input asp-for="Filters.FirstName" class="form-control" placeholder="First name…" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filters.LastName" class="form-label"></label>
                <input asp-for="Filters.LastName" class="form-control" placeholder="Last name…" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filters.Email" class="form-label"></label>
                <input asp-for="Filters.Email" class="form-control" placeholder="Email…" />
            </div>
            <div class="col-md-1">
                <label asp-for="Filters.StatusFilter" class="form-label"></label>
                <select asp-for="Filters.StatusFilter" class="form-select"
                        asp-items="Html.GetEnumSelectList<UserStatusFilter>()"></select>
            </div>
            <div class="col-md-1">
                <label asp-for="Filters.RoleFilter" class="form-label"></label>
                <select asp-for="Filters.RoleFilter" class="form-select"
                        asp-items="Html.GetEnumSelectList<UserRoleFilter>()"></select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </div>
        @if (Model.Filters.HasActiveFilters())
        {
            <div class="mt-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear filters</a>
            </div>
        }
    </div>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Results *@
@if (!Model.Items.Any())
{
    <div class="alert alert-info">No users match the current filters.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var user in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-0">@user.DisplayName</h5>
                                <small class="text-muted">@user.FullName</small>
                            </div>
                            <div class="d-flex flex-column gap-1 align-items-end">
                                <span class="@user.RoleBadgeClass">@user.Role</span>
                                <span class="@user.StatusBadgeClass">@user.StatusDisplay</span>
                            </div>
                        </div>
                        <hr />
                        <p class="mb-1"><i class="bi bi-envelope me-1"></i> @user.Email</p>
                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                        {
                            <p class="mb-1"><i class="bi bi-telephone me-1"></i> @user.PhoneNumber</p>
                        }
                        <p class="mb-1"><i class="bi bi-calendar me-1"></i> Hired @user.HireDate.ToString("dd MMM yyyy")</p>
                        <p class="mb-0"><i class="bi bi-journal-bookmark me-1"></i> @user.ReservationCount reservation(s)</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-primary flex-grow-1">Details</a>
                        <form asp-action="ToggleAdmin" asp-route-id="@user.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm @(user.Role == UserRole.Admin ? "btn-outline-warning" : "btn-outline-danger")">
                                @(user.Role == UserRole.Admin ? "Revoke Admin" : "Make Admin")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <partial name="_Pagination" model="Model" />
}