@model HotelReservationsManager.Models.ViewModels.Guest.DetailsGuestViewModel

@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-circle"></i> Guest Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.FirstName)</dt>
                    <dd class="col-sm-7">@Model.FirstName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.LastName)</dt>
                    <dd class="col-sm-7">@Model.LastName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PhoneNumber)</dt>
                    <dd class="col-sm-7">@Model.PhoneNumber</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Email)</dt>
                    <dd class="col-sm-7">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.IsAdult)</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsAdult)
                        {
                            <span class="badge bg-primary">Adult</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Minor</span>
                        }
                    </dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.ReservationCount)</dt>
                    <dd class="col-sm-7">@Model.ReservationCount</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-calendar-check"></i> Reservations</div>
            <div class="card-body p-0">
                @if (!Model.Reservations.Items.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x fs-2"></i>
                        <p class="mt-2 mb-0">No reservations yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reservation #</th>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                    <th>Room</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Reservations.Items)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Reservations" asp-action="Details"
                                               asp-route-id="@r.ReservationId">#@r.ReservationId</a>
                                        </td>
                                        <td>@r.CheckInDate.ToShortDateString()</td>
                                        <td>@r.CheckOutDate.ToShortDateString()</td>
                                        <td>@r.RoomNumber</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <partial name="_Pagination" model="@Model.Reservations" />
                }
            </div>
        </div>
    </div>
</div>
