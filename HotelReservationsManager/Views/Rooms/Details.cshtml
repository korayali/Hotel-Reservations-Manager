@model HotelReservationsManager.Models.ViewModels.Room.DetailsRoomViewModel

@{
    ViewData["Title"] = $"Room {Model.RoomNumber}";
}

<div class="d-flex mt-4 justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Room @Model.RoomNumber</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="card card-gold" style="max-width: 560px;">
    <div class="card-header">
        <i class="bi bi-door-open me-2"></i>Room Details
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.RoomNumber)</dt>
            <dd class="col-sm-7">@Model.RoomNumber</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Type)</dt>
            <dd class="col-sm-7">@Model.TypeDisplay</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Capacity)</dt>
            <dd class="col-sm-7">@Model.Capacity</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.IsFree)</dt>
            <dd class="col-sm-7">
                <span class="@Model.StatusBadgeClass">@Model.StatusDisplay</span>
            </dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PricePerAdult)</dt>
            <dd class="col-sm-7">@Model.PricePerAdult.ToString("C")</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PricePerChild)</dt>
            <dd class="col-sm-7">@Model.PricePerChild.ToString("C")</dd>
        </dl>
    </div>
</div>
