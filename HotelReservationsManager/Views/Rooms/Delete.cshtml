@model HotelReservationsManager.Models.ViewModels.Room.DeleteRoomViewModel

@{
    ViewData["Title"] = $"Delete Room {Model.RoomNumber}";
}

<div class="d-flex mt-4 justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Delete Room @Model.RoomNumber</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="card border-danger" style="max-width: 520px;">
    <div class="card-header bg-danger">
        <i class="bi bi-exclamation-triangle me-1"></i>Confirm Deletion
    </div>
    <div class="card-body">
        <p class="mb-3">Are you sure you want to permanently delete this room?</p>

        <dl class="row mb-3">
            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.RoomNumber)</dt>
            <dd class="col-sm-7">@Model.RoomNumber</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.TypeDisplay)</dt>
            <dd class="col-sm-7">@Model.TypeDisplay</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Capacity)</dt>
            <dd class="col-sm-7">@Model.Capacity</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.ActiveReservationCount)</dt>
            <dd class="col-sm-7">
                @if (Model.ActiveReservationCount > 0)
                {
                    <span class="text-danger fw-semibold">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        @Model.ActiveReservationCount active reservation(s) will also be removed.
                    </span>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Yes, Delete
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
