@model HotelReservationsManager.Models.ViewModels.Room.RoomListViewModel
@using HotelReservationsManager.Models.ViewModels.Room
@using HotelReservationsManager.Enums

@{
    ViewData["Title"] = "Rooms";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="h3 mb-0">Rooms</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Room
        </a>
    }
</div>

@* Filter Panel *@
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-funnel me-1"></i>Filters</span>
        @if (Model.Filters.HasActiveFilters())
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        }
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <label asp-for="Filters.Type" class="form-label"></label>
                    <select asp-for="Filters.Type" class="form-select"
                            asp-items="Html.GetEnumSelectList<RoomType>()">
                        <option value="">All Types</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-3">
                    <label asp-for="Filters.AvailabilityFilter" class="form-label"></label>
                    <select asp-for="Filters.AvailabilityFilter" class="form-select"
                            asp-items="Html.GetEnumSelectList<RoomAvailabilityFilter>()"></select>
                </div>
                <div class="col-sm-6 col-md-3">
                    <label asp-for="Filters.MinCapacity" class="form-label"></label>
                    <input asp-for="Filters.MinCapacity" class="form-control" type="number" min="1" max="20" />
                </div>
                <div class="col-sm-6 col-md-3">
                    <label asp-for="Filters.MaxCapacity" class="form-label"></label>
                    <input asp-for="Filters.MaxCapacity" class="form-control" type="number" min="1" max="20" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building fs-1"></i>
        <p class="mt-2">No rooms found.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Room #</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Price / Adult</th>
                    <th>Price / Child</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@room.RoomNumber</td>
                        <td>@room.TypeDisplay</td>
                        <td><i class="bi bi-people me-1 text-muted"></i>@room.Capacity</td>
                        <td><span class="@room.StatusBadgeClass">@room.StatusDisplay</span></td>
                        <td>@room.PricePerAdult.ToString("C")</td>
                        <td>@room.PricePerChild.ToString("C")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@room.Id"
                                   class="btn btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@room.Id"
                                       class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@room.Id"
                                       class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="@Model" />
}
