@model HotelReservationsManager.Models.ViewModels.Room.CreateRoomViewModel
@using HotelReservationsManager.Enums

@{
    ViewData["Title"] = "Add Room";
}

<div class="d-flex mt-4 justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Add Room</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="card card-gold" style="max-width: 560px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="RoomNumber" class="form-label"></label>
                    <input asp-for="RoomNumber" class="form-control" />
                    <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" class="form-select"
                            asp-items="Html.GetEnumSelectList<RoomType>()"></select>
                    <span asp-validation-for="Type" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>
                <div class="col-sm-6 d-flex align-items-end pb-1">
                    <div class="form-check form-switch">
                        <input asp-for="IsFree" class="form-check-input" role="switch" />
                        <label asp-for="IsFree" class="form-check-label">Available</label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PricePerAdult" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PricePerAdult" class="form-control" />
                    </div>
                    <span asp-validation-for="PricePerAdult" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PricePerChild" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PricePerChild" class="form-control" />
                    </div>
                    <span asp-validation-for="PricePerChild" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Create Room
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
