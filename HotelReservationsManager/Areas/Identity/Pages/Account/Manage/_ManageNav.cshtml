@inject SignInManager<User> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="card card-gold">
    <div class="card-header">
        <i class="bi bi-person-circle me-2"></i>My Account
    </div>
    <div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.IndexNavClass(ViewContext)"
           id="profile" href="/Identity/Account/Manage">
            <i class="bi bi-person me-2"></i>Profile
        </a>
        <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.EmailNavClass(ViewContext)"
           id="email" href="/Identity/Account/Manage/Email">
            <i class="bi bi-envelope me-2"></i>Email
        </a>
        <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)"
           id="change-password" href="/Identity/Account/Manage/ChangePassword">
            <i class="bi bi-lock me-2"></i>Password
        </a>
        @if (hasExternalLogins)
        {
            <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)"
               id="external-login" href="/Identity/Account/Manage/ExternalLogins">
                <i class="bi bi-box-arrow-in-right me-2"></i>External Logins
            </a>
        }
        <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"
           id="two-factor" href="/Identity/Account/Manage/TwoFactorAuthentication">
            <i class="bi bi-shield-check me-2"></i>Two-Factor Authentication
        </a>
        <a class="list-group-item list-group-item-action manage-nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)"
           id="personal-data" href="/Identity/Account/Manage/PersonalData">
            <i class="bi bi-database me-2"></i>Personal Data
        </a>
    </div>
</div>
